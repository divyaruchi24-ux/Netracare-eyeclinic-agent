# Copy to .env and fill in. Never commit .env.

# --- Core ---
ENVIRONMENT=dev
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./data/netracare.db
JWT_SECRET=replace-with-a-long-random-string
CLINIC_TIMEZONE=Asia/Kolkata
# Password assigned to all seeded demo users (dev only)
SEED_DEFAULT_PASSWORD=replace-me

# --- Auth / API / UI ---
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:8501"]

# --- LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
# LLM features fall back safely (rules-only triage, static eye-fact) when disabled or keyless
LLM_ENABLED=true
LLM_TIMEOUT_FAST_S=15
LLM_TIMEOUT_REASONING_S=45
LLM_MAX_RETRIES=3
PROMPTS_DIR=prompts
PRICING_FILE=config/model_pricing.yaml

# --- Triage ---
TRIAGE_CONFIDENCE_THRESHOLD=0.6
TRIAGE_RATE_LIMIT_PER_MIN=10

# --- LLM-as-judge ---
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b
JUDGE_REASONING_EFFORT=none
JUDGE_MAX_TOKENS=900

# --- Observability (Opik Cloud) ---
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=netracare
# Tracing is off unless explicitly enabled (and OPIK_API_KEY is set)
OPIK_ENABLED=false
OPIK_URL_OVERRIDE=

# --- Retrieval (fastembed ONNX models, downloaded once into MODELS_CACHE_DIR) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
CHROMA_PATH=./data/chroma
KB_DIR=kb
MODELS_CACHE_DIR=./models
RAG_BM25_K=20
RAG_VECTOR_K=20
RAG_RRF_K=60
RAG_TOP_K=5
RAG_RERANK=false
RAG_RERANK_K=5
RAG_MIN_CONFIDENCE=0.605

# --- Chat ---
CHAT_MAX_TURNS=30
CHAT_MAX_CHARS=2000
CHAT_RATE_LIMIT_PER_MIN=20
CHAT_ANON_RATE_LIMIT_PER_MIN=10
CHAT_HISTORY_TURNS=3
ROUTER_CONFIDENCE_THRESHOLD=0.6
ALERT_DEDUP_MINUTES=10
CHAT_RETENTION_DAYS=90

# --- Booking agent ---
AGENT_CHECKPOINT_PATH=./data/agent_checkpoints.db
AGENT_OPTIONS_COUNT=3
AGENT_PROPOSAL_TTL_MINUTES=30
AGENT_FLOW_EXPIRY_HOURS=24
AGENT_SEARCH_DAYS=14
AGENT_MAX_TOOL_FAILURES=2
APPROVAL_OVERDUE_HOURS=4

# --- Budgets (USD) ---
MONTHLY_LLM_BUDGET_USD=20
DAILY_LLM_BUDGET_USD=1.5
CONVERSATION_BUDGET_USD=0.05
